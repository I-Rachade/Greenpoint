# Copy to .env.local if needed. Without values, `npm run dev` runs the in-browser demo.
# "cloudflare" uses the API of the Worker (run it with `npm run dev:worker`).
NEXT_PUBLIC_BACKEND=
# Where the API lives. Empty = same domain (web app). The mobile app needs
# https://app.poinderecharge.com here.
NEXT_PUBLIC_API_URL=
# Server for the road routes drawn on the map (OSRM). Empty = the public OSRM demo
# server (no guarantee, about 1 request a second); "off" = straight line only. Another
# server also needs its address in connect-src in public/_headers.
NEXT_PUBLIC_ROUTING_URL=
