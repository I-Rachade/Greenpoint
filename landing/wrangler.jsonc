// Cloudflare Worker that serves the landing page as static files.
// Workers Builds: root directory "landing", deploy command "npx wrangler deploy".
{
  "name": "greenpoint",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "pointderecharge.com", "zone_name": "pointderecharge.com", "custom_domain": true },
    { "pattern": "www.pointderecharge.com", "zone_name": "pointderecharge.com", "custom_domain": true }
  ]
}
