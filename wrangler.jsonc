// Cloudflare Worker "greenpoint": serves the landing page in landing/ as static files.
// Works with Workers Builds whether the root directory is "/" (this file) or "landing" (landing/wrangler.jsonc).
{
  "name": "greenpoint",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./landing"
  },
  "routes": [
    { "pattern": "pointderecharge.com", "custom_domain": true },
    { "pattern": "www.pointderecharge.com", "custom_domain": true }
  ]
}
