{
  "name": "poinderecharge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p worker/tsconfig.test.json",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev:worker": "npm run build && wrangler dev",
    "db:migrate": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "maplibre-gl": "^6.14.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.149.0"
  }
}
